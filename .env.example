# AdGuardHome 连接配置（被管理端，即你要分析的那台 AdGuardHome）
ADGH_URL=http://192.168.1.100
ADGH_USER=你的用户名
ADGH_PASSWD=你的密码

# SSL 验证（自签名证书时设为 false）
ADGH_SKIP_VERIFY=false

# 服务端口（可选，默认 3080）
# PORT=3080

# 准入凭据（HTTP Basic）。这是本面板自己的登录名/密码，跟上面那组 AdGuardHome
# 凭据不是一回事。两个都填上才启用；启用后网页、静态文件、/api/health 全都要过。
# 不填时 HOST 必须留在回环地址（127.0.0.1 / localhost / ::1），显式设成
# 0.0.0.0 这类非回环地址会在启动时直接退出，退出码非 0。
# 密码建议用长随机串，例如 openssl rand -base64 24
# ADGH_AUTH_USER=admin
# ADGH_AUTH_PASSWD=换成强密码

# 监听地址（可选）。不配准入凭据时：不设置 → 默认 127.0.0.1；
# 显式设成非回环地址 → 启动直接退出。
# Docker 镜像内置 HOST=0.0.0.0，容器部署必须配准入凭据，或把 HOST 覆盖成回环地址。
# HOST=127.0.0.1
